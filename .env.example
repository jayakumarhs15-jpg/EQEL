# ===================================
# EQEL Environment Variables
# Copy this file to .env and fill in actual values.
# NEVER commit the .env file.
# ===================================

# --- Database ---
EQEL_DB_HOST=localhost
EQEL_DB_PORT=3306
EQEL_DB_NAME=eqel_db
EQEL_DB_USER=eqel_user
EQEL_DB_PASSWORD=CHANGE_ME

# --- Server ---
EQEL_SERVER_PORT=8081

# --- CORS ---
EQEL_CORS_ORIGINS=http://localhost:5173

# --- Admin Bootstrap (dev only) ---
EQEL_ADMIN_BOOTSTRAP_USERNAME=admin
EQEL_ADMIN_BOOTSTRAP_PASSWORD=CHANGE_ME
EQEL_ADMIN_BOOTSTRAP_EMAIL=admin@eqel.local
